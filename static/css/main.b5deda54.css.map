header {
    background-color: rgb(255, 255, 255);
    width: 100%;
    height: 45px;
    padding: 5px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    overflow: visible;
    position: relative;
    position: sticky;
    z-index: 1000;
    top: 0;
}

.nightMorning {
    width: 70px;
    height: 70%;
    background-color: rgb(216, 225, 225);
    border-radius: 50px;
    display: flex;
    align-items: center;
    justify-content: start;
}

.moveImgX {
    transform: translateX(180%);
    transition: all 0.5s ease;
}

.moveImgY {
    transform: translateX(0);
    transition: all 0.5s ease;
}

.menoAndTranslater {
    width: 70px;
    height: 70%;
    justify-content: center;
    align-items: center;
    display: flex;
    padding-right: 15px;
}

@media (max-width: 768px) {
    .iconRightHeaderTranslater {
        width: 20px;
        height: 20px;
    }
    .iconRightHeaderMeno {
        width: 20px;
        height: 20px;
    }
}

.overlay {
    height: 100%;
    width: 100%;
    position: fixed;
    top: 0;
    left: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 799;
    animation: SS 1s ease;
}

@keyframes SS {
    from { opacity: 0; }
    to { opacity: 1; }
}

.moveMeno {
    position: fixed;
    top: 0;
    left: -40%;
    width: 40%;
    height: 100vh;
    background-color: #1a73e8;
    transition: all 1s ease;
    z-index: 800;
    box-shadow: 2px 0 20px rgba(0, 0, 0, 0.712);
    padding: 20px 5% 5% 5%;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.moveMeno.open {
    left: 0;
}

@media(max-width: 768px){
    .moveMeno{
        left: -60%;
        width: 60%;
    }
}


.dropItem{
    width: 100%;
    min-height: 50px;
    border-radius: 10px;
    border: none;
    background-color: rgba(255, 255, 255, 0.692);
    justify-content: center;
    align-items: center;
    display: flex;
    gap: 10px;
    margin-bottom: 8px;
}

.styleContactUs{
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.74);
    transition: all 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 0 5px;
}

.styleContactUs1{
    max-height: 500px;
    opacity: 1;
    width: 100%;
    padding: 5px;
    border-radius: 8px;
    overflow-y: auto;
}

.styleContactUs1::-webkit-scrollbar {
    width: 9px;
}.styleContactUs1::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.05);
    border-radius: 10px;
}.styleContactUs1::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, #fbbf24, #f59e0b);
    border-radius: 10px;
}.styleContactUs1::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, #f59e0b, #fbbf24);
    box-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
}

.styleSS{
    display: flex;
    align-items: center;
    flex-direction: column;
    margin: 0;
    padding: 0;
    gap: 15px;
    padding: 10px;
}

.styleSS li{
    list-style: none;
    justify-content: flex-start;
    gap: 10px;
    display: flex;
    width: 100%;
    padding: 8px;
    border-radius: 4px;
}

@media(max-width: 768px){
    .icon{
        width:  23px;
        height: 23px;
    }
    li span{
        font-size: 15px;
    }
}

.styleSS li:active{
    background-color: #969696a0;
}

.support {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    color: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.3);
    padding: 16px 40px;
    border-radius: 50px;
    font-size: 17px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: auto;
}

.support:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: #fbbf24;
    transform: translateY(-3px);
    box-shadow: 0 8px 35px rgba(251, 191, 36, 0.3);
}

header {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    width: 100%;
    height: 45px;
    padding: 5px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 2px 10px var(--shadow);
    transition: background-color 0.3s ease;
}

strong {
    color: var(--accent);
    font-size: 20px;
}

b {
    color: var(--gold);
}