.heroDad{
    width: 100%;
    display: flex;
    height: 100vh;
    padding: 18px;
    flex-direction: column;
}

.consProfileAndMyJob{
    width: 90%;
    height: 55%;
    padding: 10px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    gap: 5%;
    align-items: center;
}

.nameMyJob{
    flex-direction: column;
    justify-content: center;
    display: flex;
    gap: 0;
    line-height: 0.8;
}

.nameMyJob strong{
    font-size: 150px;
}

.colorText{
    color: #fbbf24;
    -webkit-text-stroke: 3px black;
}

.profile{
    width: 28%;
    height: 100%;
    border-radius: 255px;
    border: #fbbf24 6px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--text-primary);
}

.ME {
    width: 99%;
    height: 99%;
    object-fit: cover;
    display: block;
    border-radius: 255px;
}

@media (max-width: 480px) {
    .consProfileAndMyJob{
        flex-direction: column-reverse;
        gap: 2;
    }

    .nameMyJob strong{
        font-size: 69px;
    }

    .colorText{
    color: #fbbf24;
    -webkit-text-stroke: 1.5px black;
    }

    .profile{
    width: 80%;
    border: #fbbf24 4px solid;
    }
}


.text{
    width: 90%;
    height: 25%;
    margin: 0 auto;
    margin-top: 1%;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    line-height: 0.1;
}

.text p{
    font-size: larger;
    font-weight: 700;
    font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
    line-height: normal;
}

@media (max-width: 480px) {
    .text{
    height: 30%;
    text-align: center;
    }

    .text p{
    font-size: medium;
    line-height: 1.3;
    }
}

.boxButtom{
    width: 60%;
    height: 10%;
    margin: 0 auto;
    margin-top: 10px;
    align-items: center;
    justify-content: space-between;
    display: flex;
}

.btnNext{
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #0f172a;
    border: none;
    padding: 16px 40px;
    border-radius: 50px;
    font-size: 17px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 25px rgba(251, 191, 36, 0.3);
}

.btnBetwen{
    background: linear-gradient(135deg, #1a73e8, #2563eb);
    color: #ffffff;
    border: none;
    padding: 16px 40px;
    border-radius: 50px;
    font-size: 17px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 25px rgba(26, 115, 232, 0.3);
}

@media (max-width: 480px) {
    .boxButtom{
    width: 100%;
    margin-top: 0;
    }

    .btnNext{
    padding: 14px 15px;
    font-size: 15px;
    }

    .btnBetwen{
    padding: 19px 20px;
    font-size: 15px;
    }
}

.heroDad {
    transition: background-color 0.3s ease;
}

.colorText {
    color: var(--gold);
    -webkit-text-stroke: 1.5px var(--stroke-color);
}